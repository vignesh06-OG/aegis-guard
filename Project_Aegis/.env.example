# Project Aegis - SMTP / Alert Configuration Example
# Copy this file to .env and fill in your real credentials before running the
# dashboard or the attack simulator.  Never commit the real .env file.

# SMTP provider (examples: smtp.gmail.com, email-smtp.us-east-1.amazonaws.com,
# smtp.postmarkapp.com, mailhog for local testing)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Use STARTTLS for port 587 (default). Set to 0 for plain SMTP / MailHog.
SMTP_STARTTLS=1

# SMTP login credentials. For Gmail you MUST use an App Password, not your
# regular password: https://myaccount.google.com/apppasswords
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here

# Who receives the CRITICAL alert when ransomware is intercepted
ALERT_RECIPIENT=security@yourcompany.com

# Optional: sender address shown in the inbox. Defaults to SMTP_USER.
ALERT_SENDER=Aegis Interception Daemon <security@yourcompany.com>
